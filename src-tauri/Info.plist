<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>A program running within Terax would like to use the camera.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>A program running within Terax would like to use your microphone.</string>
	<!-- In-app web tabs open internal systems over plain http (e.g. 内核管理系统
	     at http://39.100.83.89:40135). ATS blocks those in WKWebView for a
	     bundled app, so relax it for web content only; the app's own network
	     code keeps the default. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
</dict>
</plist>
